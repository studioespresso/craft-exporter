{% extends '_layouts/cp' %}
{% import '_includes/forms' as forms %}

{% do view.registerAssetBundle('craft\\web\\assets\\conditionbuilder\\ConditionBuilderAsset') %}

{% set title = 'Configure condition builder' %}
{% set crumbs = [
    { label: 'Exporter', url: url('exporter') },
] %}

{% block content %}
    <form method="post" accept-charset="UTF-8">
        {{ csrfInput() }}
        {{ hiddenInput('action', 'exporter/element/save-condition-builder') }}
        {{ hiddenInput('elementId', export.id) }}

        {% do condition.setAttributes({
                mainTag: 'div',
                id: 'condition',
                name: 'condition'
            }, false) %}

        {{ forms.field({
                label: 'Filter Conditions'|t,
                instructions: 'Define the conditions that your entries must meet to be included in this export.'|t('contacts'),
                id: 'condition-field'
            }, condition.getBuilderHtml()) }}

        <button class="btn submit" type="submit">Save</button>
    </form>
{% endblock %}
